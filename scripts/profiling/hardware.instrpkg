<?xml version='1.0' encoding='utf-8'?>
<package>
  <id>org.reversi.hardware-sampling</id>
  <title>Reversi Hardware Sampling</title>
  <owner>
    <name>Reversi</name>
  </owner>
  <import-schema>pmi-sample</import-schema>
  <import-schema>kdebug-counters-with-time-sample</import-schema>
  <import-schema>os-signpost</import-schema>
  <instrument>
    <id>org.reversi.hardware-sampling.ip1000000</id>
    <title>Reversi Cycles IP 1000000</title>
    <category>CPU</category>
    <purpose>Reversi Cycles IP 1000000 with explicit stack requirement.</purpose>
    <icon>Generic</icon>
    <create-table>
      <id>ips</id>
      <schema-ref>pmi-sample</schema-ref>
      <attribute>
        <name>target</name>
        <string>SINGLE</string>
      </attribute>
      <attribute>
        <name>callstack</name>
        <array />
      </attribute>
      <attribute>
        <name>pmi-event</name>
        <string>CORE_ACTIVE_CYCLE</string>
      </attribute>
      <attribute>
        <name>pmi-threshold</name>
        <integer>1000000</integer>
      </attribute>
    </create-table>
    <create-table>
      <id>config</id>
      <schema-ref>kdebug-counters-with-time-sample</schema-ref>
      <attribute>
        <name>target</name>
        <string>SINGLE</string>
      </attribute>
      <attribute>
        <name>callstack</name>
        <array />
      </attribute>
      <attribute>
        <name>pmc-events</name>
        <array>
          <string>CORE_ACTIVE_CYCLE</string>
        </array>
      </attribute>
      <attribute>
        <name>sample-rate-micro-seconds</name>
        <integer>10000</integer>
      </attribute>
    </create-table>
    <create-table>
      <id>markers</id>
      <schema-ref>os-signpost</schema-ref>
      <attribute>
        <name>target-pid</name>
        <string>SINGLE</string>
      </attribute>
      <attribute>
        <name>category</name>
        <array>
          <string>PointsOfInterest</string>
        </array>
      </attribute>
    </create-table>
    <list>
      <title>PMI records</title>
      <table-ref>ips</table-ref>
      <add-all-columns />
    </list>
  </instrument>
